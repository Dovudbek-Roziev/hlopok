{
  "expo": {
    "name": "Хлопок",
    "slug": "hlopok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kg.osh.hlopok"
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFD700"
      },
      "package": "kg.osh.hlopok",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#FFD700"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFD700",
          "defaultChannel": "orders",
          "sounds": []
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "5e1406e3-5a4d-4de3-8f48-b4f8c53465b9"
      }
    },
    "owner": "ri.db"
  }
}
